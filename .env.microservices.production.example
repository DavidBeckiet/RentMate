# Active RentMate microservice production template. Populate it only through an approved secret/configuration store.
# The placeholders deliberately fail `npm run deploy:validate` until replaced.

NODE_ENV=production
FRONTEND_ORIGIN=https://app.rentmate.example
NEXT_PUBLIC_API_BASE_URL=https://api.rentmate.example
LOG_LEVEL=info
COOKIE_SECURE=true
DEPLOYMENT_ENVIRONMENT=production
RENTMATE_RELEASE_VERSION=<immutable-release-version>
RENTMATE_IMAGE_TAG=<same-as-immutable-release-version>
RENTMATE_SOURCE_REVISION=<exact-40-or-64-character-git-revision>

POSTGRES_PASSWORD=<high-entropy-postgresql-password>
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=<at-least-32-byte-jwt-secret>
SERVICE_INTERNAL_TOKEN=<different-at-least-32-byte-internal-token>
BCRYPT_COST=12
RENTMATE_ADMIN_EMAIL=<initial-admin-email>
RENTMATE_ADMIN_PASSWORD=<initial-admin-password>
RENTMATE_ADMIN_PHONE_E164=

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=<rentmate-production-user-agent-with-operator-contact>

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
EMAIL_DELIVERY_PROVIDER=
PHONE_DELIVERY_PROVIDER=

OTEL_METRIC_EXPORT_INTERVAL_MS=10000
RENTMATE_SMOKE_REQUIRE_AUTHENTICATED=true
RENTMATE_SMOKE_TENANT_EMAIL=<dedicated-active-tenant-email>
RENTMATE_SMOKE_TENANT_PASSWORD=<dedicated-tenant-password>
RENTMATE_SMOKE_LANDLORD_EMAIL=<dedicated-active-landlord-email>
RENTMATE_SMOKE_LANDLORD_PASSWORD=<dedicated-landlord-password>
RENTMATE_SMOKE_ADMIN_EMAIL=<dedicated-active-admin-email>
RENTMATE_SMOKE_ADMIN_PASSWORD=<dedicated-admin-password>
RENTMATE_SMOKE_PUBLIC_LISTING_ID=
RENTMATE_SMOKE_ALLOW_LOCAL=false
