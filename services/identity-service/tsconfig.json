{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../shared/node_modules/@types"]
  },
  "include": [
    "src/**/*.ts",
    "migrate.ts",
    "backfill.ts",
    "../shared/database-overrides.ts",
    "../shared/src/runtime/shared/types/express.d.ts"
  ]
}
