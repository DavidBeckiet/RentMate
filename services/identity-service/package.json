{
  "name": "rentmate-identity-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.1 <23"
  },
  "scripts": {
    "dev": "tsx --import ../shared/observability/register.mjs watch src/server.ts",
    "start": "tsx --import ../shared/observability/register.mjs src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:migrations": "node --import tsx --test test/migration-runner.test.ts",
    "test:profile-identity": "node --import tsx --test test/profile-identity-api.test.ts",
    "test:profile-identity:database": "node --import tsx --test test/profile-identity-api.database.ts",
    "test:tenant-verification:database": "node --import tsx --test test/tenant-contact-verification.database.ts",
    "admin:provision": "tsx admin-provision.ts",
    "migrate": "tsx migrate.ts",
    "backfill": "tsx backfill.ts"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "jose": "6.2.6",
    "tsx": "4.19.4"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0"
  }
}
