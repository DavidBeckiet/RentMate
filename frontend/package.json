{
  "name": "rentmate-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.mts",
    "test:rm045": "vitest run --config vitest.config.mts app/page.test.tsx components/ui/app-shell.test.tsx lib/api/transport.test.ts lib/api/client.test.ts lib/auth/auth-provider.test.tsx lib/auth/auth-guard.test.tsx test/rm045-application-isolation.test.ts",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check ."
  },
  "dependencies": {
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.9",
    "jsdom": "29.1.1",
    "postcss": "8.5.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
