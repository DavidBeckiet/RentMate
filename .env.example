# Backend server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL (also used by Docker Compose)
POSTGRES_DB=rentmate
POSTGRES_USER=rentmate
POSTGRES_PASSWORD=rentmate_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentmate
DB_USER=rentmate
DB_PASSWORD=rentmate_dev_password
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Runtime security and fixed application limits
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=7200
BCRYPT_COST=12
COOKIE_SECURE=false
MAX_IMAGES_PER_LISTING=8
MAX_IMAGE_BYTES=5242880
DEPLOYMENT_REGION=HO_CHI_MINH_CITY_VN
MAX_SEARCH_RADIUS_KM=50

# Backend-only provider configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=

# Disposable test database; the name must start with rentmate_test
TEST_DATABASE_URL=

# Controlled admin provisioning (set secrets only in an uncommitted .env or protected deployment environment)
RENTMATE_ADMIN_EMAIL=
RENTMATE_ADMIN_PASSWORD=
RENTMATE_ADMIN_PHONE_E164=
