# Backend server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (also used by Docker Compose)
POSTGRES_DB=rentmate
POSTGRES_USER=rentmate
POSTGRES_PASSWORD=rentmate_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentmate
DB_USER=rentmate
DB_PASSWORD=rentmate_dev_password

# Disposable test database; the name must start with rentmate_test
TEST_DATABASE_URL=postgresql://rentmate:rentmate_dev_password@localhost:5432/rentmate_test
