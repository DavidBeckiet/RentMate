# Backend server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
LOG_LEVEL=info

# PostgreSQL (also used by Docker Compose)
POSTGRES_DB=rentmate
POSTGRES_USER=rentmate
POSTGRES_PASSWORD=rentmate_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentmate
DB_USER=rentmate
DB_PASSWORD=rentmate_dev_password
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Runtime security and fixed application limits
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=7200
BCRYPT_COST=12
COOKIE_SECURE=false
MAX_IMAGES_PER_LISTING=8
MAX_IMAGE_BYTES=5242880
DEPLOYMENT_REGION=HO_CHI_MINH_CITY_VN
MAX_SEARCH_RADIUS_KM=50
LISTING_STALE_REMINDER_DAYS=30
LISTING_STALE_GRACE_DAYS=7
LISTING_STALE_SCAN_INTERVAL_MS=30000
LISTING_STALE_BATCH_SIZE=100

# Backend-only provider configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
# Verification-delivery adapter (backend-only; keep real values out of Git)
EMAIL_DELIVERY_PROVIDER=
BREVO_API_KEY=
BREVO_EMAIL_SENDER=
BREVO_EMAIL_SENDER_NAME=RentMate
BREVO_API_BASE_URL=https://api.brevo.com
BREVO_TIMEOUT_MS=5000
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=5000
PHONE_DELIVERY_PROVIDER=
PHONE_DEV_PREVIEW_ENABLED=false
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_API_BASE_URL=https://api.speedsms.vn/index.php
SPEEDSMS_TIMEOUT_MS=5000
VERIFICATION_DELIVERY_ADAPTER_PORT=4400
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4001/api/v1/auth/google/callback

# Frontend feature flag; set true only after the backend OAuth config is ready.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Disposable test database; the name must start with rentmate_test
TEST_DATABASE_URL=

# Roommate V3 AI (Engagement service only). Keep disabled unless the approved rollout gates are met.
ROOMMATE_AI_PROVIDER=DISABLED
ROOMMATE_AI_ENABLED=false
ROOMMATE_AI_PARSER_ENABLED=false
ROOMMATE_AI_RECOMMENDATION_ENABLED=false
ROOMMATE_AI_EXPLANATION_ENABLED=false
ROOMMATE_AI_SAFETY_MODE=OFF
# Server-side only. Do not add a NEXT_PUBLIC_GEMINI_API_KEY variable.
GEMINI_API_KEY=
ROOMMATE_AI_PARSER_MODEL=
ROOMMATE_AI_RECOMMENDATION_MODEL=
ROOMMATE_AI_EXPLANATION_MODEL=
ROOMMATE_AI_SAFETY_MODEL=
ROOMMATE_AI_PARSER_TIMEOUT_MS=5000
ROOMMATE_AI_RECOMMENDATION_TIMEOUT_MS=8000
ROOMMATE_AI_EXPLANATION_TIMEOUT_MS=5000
ROOMMATE_AI_SAFETY_TIMEOUT_MS=6000
ROOMMATE_AI_MAX_CONCURRENCY=4
ROOMMATE_AI_ROLLOUT_PERCENTAGE=0

# Controlled admin provisioning (set secrets only in an uncommitted .env or protected deployment environment)
RENTMATE_ADMIN_EMAIL=
RENTMATE_ADMIN_PASSWORD=
RENTMATE_ADMIN_PHONE_E164=
