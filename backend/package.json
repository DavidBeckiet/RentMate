{
  "name": "rentmate-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test vitest.config.mts vitest.database.config.mts eslint.config.mjs --max-warnings=0",
    "test": "vitest run --config vitest.config.mts",
    "test:database": "vitest run --config vitest.database.config.mts",
    "test:migrations": "vitest run --config vitest.config.mts test/migrations",
    "test:migrations:database": "vitest run --config vitest.database.config.mts test/migrations.integration.test.ts",
    "test:rm005": "vitest run --config vitest.config.mts test/migrations/rm005-inventory.test.ts",
    "test:rm005:database": "vitest run --config vitest.database.config.mts test/rm005-schema.integration.test.ts",
    "test:rm006": "vitest run --config vitest.config.mts test/migrations/rm006-inventory.test.ts",
    "test:rm006:database": "vitest run --config vitest.database.config.mts test/rm006-schema.integration.test.ts",
    "migrate:clean": "tsx src/db/migrations/cli.ts clean",
    "migrate:existing": "tsx src/db/migrations/cli.ts existing",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check ."
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "pg": "8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.4",
    "supertest": "7.2.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
