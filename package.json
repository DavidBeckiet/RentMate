{
  "name": "rentmate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,magenta \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:migrations": "npm --prefix backend run test:migrations",
    "test:migrations:database": "npm --prefix backend run test:migrations:database",
    "test:rm005": "npm --prefix backend run test:rm005",
    "test:rm005:database": "npm --prefix backend run test:rm005:database",
    "test:rm006": "npm --prefix backend run test:rm006",
    "test:rm006:database": "npm --prefix backend run test:rm006:database",
    "test:rm007": "npm --prefix backend run test:rm007",
    "test:rm007:database": "npm --prefix backend run test:rm007:database",
    "test:rm008": "npm --prefix backend run test:rm008",
    "test:rm008:database": "npm --prefix backend run test:rm008:database",
    "test:rm009": "npm --prefix backend run test:rm009",
    "test:rm009:database": "npm --prefix backend run test:rm009:database",
    "test:rm010": "npm --prefix backend run test:rm010",
    "test:rm011": "npm --prefix backend run test:rm011",
    "test:rm012": "npm --prefix backend run test:rm012",
    "test:rm013": "npm --prefix backend run test:rm013",
    "test:rm014": "npm --prefix backend run test:rm014",
    "test:rm015": "npm --prefix backend run test:rm015",
    "test:rm015:database": "npm --prefix backend run test:rm015:database",
    "test:rm016": "npm --prefix backend run test:rm016",
    "test:rm016:database": "npm --prefix backend run test:rm016:database",
    "migrate:clean": "npm --prefix backend run migrate:clean --",
    "migrate:existing": "npm --prefix backend run migrate:existing --",
    "admin:provision": "npm --prefix backend run admin:provision",
    "db:verify": "npm --prefix backend run db:verify",
    "db:bootstrap": "npm --prefix backend run db:bootstrap",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "prettier": "3.6.2"
  }
}
