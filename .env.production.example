# RentMate production template. Replace every angle-bracket placeholder through the platform secret/config store.
# This file is documentation only; never commit a populated copy.

# Backend runtime
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://app.rentmate.example
LOG_LEVEL=info

# Database
DB_HOST=<managed-postgresql-host>
DB_PORT=5432
DB_NAME=rentmate
DB_USER=<least-privilege-application-user>
DB_PASSWORD=<secret-from-platform-store>
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Authentication and browser security
JWT_SECRET=<high-entropy-secret-from-platform-store>
JWT_EXPIRES_IN_SECONDS=7200
BCRYPT_COST=12
COOKIE_SECURE=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=<rentmate-production-user-agent-with-operator-contact>

# Email and SMS verification webhook
VERIFICATION_DELIVERY_URL=https://verification-provider.example.com/rentmate
VERIFICATION_DELIVERY_TOKEN=<long-random-provider-token>

# Frozen listing and search policies
MAX_IMAGES_PER_LISTING=8
MAX_IMAGE_BYTES=5242880
DEPLOYMENT_REGION=HO_CHI_MINH_CITY_VN
MAX_SEARCH_RADIUS_KM=50

# Frontend build (public; baked into the Next.js artifact)
NEXT_PUBLIC_API_BASE_URL=https://api.rentmate.example

# Controlled admin provisioning
RENTMATE_ADMIN_EMAIL=<controlled-admin-email>
RENTMATE_ADMIN_PASSWORD=<admin-secret-from-platform-store>
RENTMATE_ADMIN_PHONE_E164=<optional-e164-phone-or-blank>

# Non-destructive production smoke actors and known public listing
RENTMATE_SMOKE_TENANT_EMAIL=<dedicated-smoke-tenant-email>
RENTMATE_SMOKE_TENANT_PASSWORD=<dedicated-smoke-tenant-secret>
RENTMATE_SMOKE_LANDLORD_EMAIL=<dedicated-smoke-landlord-email>
RENTMATE_SMOKE_LANDLORD_PASSWORD=<dedicated-smoke-landlord-secret>
RENTMATE_SMOKE_ADMIN_EMAIL=<dedicated-smoke-admin-email>
RENTMATE_SMOKE_ADMIN_PASSWORD=<dedicated-smoke-admin-secret>
RENTMATE_SMOKE_PUBLIC_LISTING_ID=<known-approved-listing-id>

# Explicit provider connectivity check
RENTMATE_PROVIDER_CHECK_ADDRESS=<one-hcmc-address-for-bounded-forward-geocoding>

# TEST_DATABASE_URL is test-only and must never be configured as a production runtime value.
