# Local Compose/development template. Do not reuse these values in staging or production.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
POSTGRES_PASSWORD=rentmate_dev_password
JWT_SECRET=rentmate_local_jwt_secret_not_for_production
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=local-cloud-name
CLOUDINARY_API_KEY=local-api-key
CLOUDINARY_API_SECRET=local-api-secret
NOMINATIM_USER_AGENT=RentMate local development
SERVICE_INTERNAL_TOKEN=rentmate-local-internal-token-not-for-production

# The active topology requires the isolated service databases below to be created and migrated.
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4001/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
IDENTITY_SERVICE_URL=http://localhost:4100

# Identity Service
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=rentmate_identity
IDENTITY_DB_USER=rentmate
IDENTITY_DB_PASSWORD=rentmate_dev_password

# Listing Service database
LISTING_DB_HOST=localhost
LISTING_DB_PORT=5432
LISTING_DB_NAME=rentmate_listing
LISTING_DB_USER=rentmate
LISTING_DB_PASSWORD=rentmate_dev_password

# Engagement Service database
ENGAGEMENT_DB_HOST=localhost
ENGAGEMENT_DB_PORT=5432
ENGAGEMENT_DB_NAME=rentmate_engagement
ENGAGEMENT_DB_USER=rentmate
ENGAGEMENT_DB_PASSWORD=rentmate_dev_password

# Local observability. Compose provides the collector endpoint to services.
DEPLOYMENT_ENVIRONMENT=local
RENTMATE_RELEASE_VERSION=development
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local load-test controls. Authenticated test credentials remain process-local.
RENTMATE_BASE_URL=http://host.docker.internal:4001
K6_TARGET_VUS=10
K6_RAMP_DURATION=10s
K6_HOLD_DURATION=30s
