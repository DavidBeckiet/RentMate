# Use the service-specific database values below only after creating and migrating those databases.
# Leave a service's *_DB_* values unset to keep that service on the compatibility database.
SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
IDENTITY_SERVICE_URL=http://localhost:4100

# Identity Service
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=rentmate_identity
IDENTITY_DB_USER=rentmate
IDENTITY_DB_PASSWORD=rentmate_dev_password

# Listing Service database
LISTING_DB_HOST=localhost
LISTING_DB_PORT=5432
LISTING_DB_NAME=rentmate_listing
LISTING_DB_USER=rentmate
LISTING_DB_PASSWORD=rentmate_dev_password

# Engagement Service database
ENGAGEMENT_DB_HOST=localhost
ENGAGEMENT_DB_PORT=5432
