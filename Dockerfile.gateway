FROM node:22.15-alpine

WORKDIR /app
COPY services/shared/package.json services/shared/package-lock.json ./services/shared/
RUN npm ci --omit=dev --prefix services/shared
COPY services/shared/observability ./services/shared/observability
COPY services/api-gateway ./services/api-gateway

ARG RELEASE_VERSION=development
ARG SOURCE_REVISION=unknown
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="rentmate-gateway" \
  org.opencontainers.image.version="${RELEASE_VERSION}" \
  org.opencontainers.image.revision="${SOURCE_REVISION}" \
  org.opencontainers.image.vendor="RentMate"

USER node

CMD ["node", "services/api-gateway/server.mjs"]
